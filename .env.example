# Admin sign-in (used the first time the server starts, when data/users.json does not exist yet)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-admin-password
PORT=3000

# Optional SMS delivery (Twilio). Set all four values to enable real SMS.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-secret-token
TWILIO_FROM=+12345678900
PUBLIC_BASE_URL=https://your-render-service.onrender.com
